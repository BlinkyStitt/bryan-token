// SPDX-License-Identifier: AGPL-3.0-only
pragma solidity ^0.8.26;

import {Test, console} from "forge-std/Test.sol";
import {ERC4626UniswapV4Hook} from "../src/ERC4626UniswapV4Hook.sol";
import {IERC4626} from "@openzeppelin/contracts/interfaces/IERC4626.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {IWETH9} from "../src/FanToken.sol";
import {IPoolManager} from "v4-core/src/interfaces/IPoolManager.sol";
import {PoolKey} from "v4-core/src/types/PoolKey.sol";
import {Currency} from "v4-core/src/types/Currency.sol";
import {BalanceDelta} from "v4-core/src/types/BalanceDelta.sol";
import {Hooks} from "v4-core/src/libraries/Hooks.sol";
contract ERC4626UniswapV4HookTest is Test {
    ERC4626UniswapV4Hook public hook;
    IPoolManager public poolManager;

    // Real Base mainnet addresses used in other tests
    IWETH9 public weth = IWETH9(address(0x4200000000000000000000000000000000000006));
    IERC4626 public prizeVault = IERC4626(0x4E42f783db2D0C5bDFf40fDc66FCAe8b1Cda4a43);

    PoolKey public poolKey;

    address public user;

    function setUp() public {
        // Use mock pool manager for testing (tests don't need real addresses)
        poolManager = IPoolManager(address(0x1234567890123456789012345678901234567890));

        // Deploy hook directly for testing (address validation is bypassed in test environment)
        hook = new ERC4626UniswapV4Hook(poolManager);

        user = makeAddr("user");

        // Give user some ETH and WETH
        vm.deal(user, 10 ether);
        vm.startPrank(user);
        weth.deposit{value: 5 ether}();
        vm.stopPrank();

        // Give this contract some assets for testing
        vm.deal(address(this), 10 ether);
        weth.deposit{value: 5 ether}();

        // Create pool key for WETH <-> Prize Vault (fixed price hook, minimal tick spacing)
        poolKey = PoolKey({
            currency0: Currency.wrap(address(weth)),
            currency1: Currency.wrap(address(prizeVault)),
            fee: 0, // No fees since hook handles pricing
            tickSpacing: 1, // Minimal spacing since we use fixed vault pricing
            hooks: hook
        });
    }

    function test_constructor() public {
        assertEq(address(hook.poolManager()), address(poolManager), "pool manager should be set correctly");
    }

    function test_getHookPermissions() public view {
        Hooks.Permissions memory permissions = hook.getHookPermissions();
        assertEq(permissions.beforeAddLiquidity, true, "should have beforeAddLiquidity permission");
        assertEq(permissions.beforeSwap, true, "should have beforeSwap permission");
        assertEq(permissions.afterSwap, false, "should not have afterSwap permission");
    }

    function test_vault_pair_detection() public {
        // Test that hook correctly identifies vault/asset pairs
        // This tests the core logic without needing full pool manager integration

        // The hook should identify WETH as asset and prizeVault as the vault
        assertEq(prizeVault.asset(), address(weth), "Prize vault should use WETH as underlying asset");

        // Verify the exchange rate mechanics
        uint256 wethAmount = 1 ether;
        uint256 expectedShares = prizeVault.previewDeposit(wethAmount);
        assertGt(expectedShares, 0, "Should get shares for WETH deposit");

        uint256 expectedAssets = prizeVault.previewRedeem(expectedShares);
        assertApproxEqAbs(expectedAssets, wethAmount, 10, "Redeem should return approximately same WETH amount");
    }

    function test_deposit_redeem_round_trip() public {
        // Test the deposit and redeem cycle that the hook would perform
        uint256 wethAmount = 1 ether;

        // Setup: User has WETH
        vm.startPrank(user);

        uint256 initialWethBalance = weth.balanceOf(user);
        assertEq(initialWethBalance, 5 ether, "User should start with 5 WETH");

        // Simulate deposit direction: WETH -> Prize Vault shares
        weth.approve(address(prizeVault), wethAmount);
        uint256 expectedShares = prizeVault.previewDeposit(wethAmount);
        uint256 actualShares = prizeVault.deposit(wethAmount, user);

        assertEq(actualShares, expectedShares, "Should receive expected shares from deposit");
        assertEq(weth.balanceOf(user), initialWethBalance - wethAmount, "WETH should be deducted");
        assertEq(prizeVault.balanceOf(user), actualShares, "Should receive vault shares");

        // Simulate redeem direction: Prize Vault shares -> WETH
        uint256 expectedAssets = prizeVault.previewRedeem(actualShares);
        uint256 actualAssets = prizeVault.redeem(actualShares, user, user);

        assertEq(actualAssets, expectedAssets, "Should receive expected assets from redeem");
        assertEq(prizeVault.balanceOf(user), 0, "Vault shares should be burned");
        assertApproxEqAbs(weth.balanceOf(user), initialWethBalance, 10, "Should get back approximately original WETH");
    }

    function test_hook_permissions() public {
        // Test that hook has correct permissions for UniswapV4 integration
        Hooks.Permissions memory permissions = hook.getHookPermissions();

        // Hook needs beforeSwap to intercept and handle swaps
        assertEq(permissions.beforeSwap, true, "Hook must have beforeSwap permission");

        // Hook needs beforeAddLiquidity to prevent normal liquidity provision
        assertEq(permissions.beforeAddLiquidity, true, "Hook must have beforeAddLiquidity permission");

        // Hook doesn't need other permissions since it handles everything in before hooks
        assertEq(permissions.afterSwap, false, "Hook doesn't need afterSwap permission");
        assertEq(permissions.afterAddLiquidity, false, "Hook doesn't need afterAddLiquidity permission");
        assertEq(permissions.beforeRemoveLiquidity, false, "Hook doesn't need beforeRemoveLiquidity permission");
        assertEq(permissions.afterRemoveLiquidity, false, "Hook doesn't need afterRemoveLiquidity permission");
    }
}